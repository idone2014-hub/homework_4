QMainWindow,
QDialog {
    background-color: #f4f7fb;
}

#centralWidget {
    background-color: #f4f7fb;
}

QLabel {
    color: #233044;
    font-size: 14px;
}

#heading {
    color: #17243a;
    font-size: 27px;
    font-weight: 700;
}

#subtitle {
    color: #6b778c;
    font-size: 14px;
    margin-top: -12px;
}

QPushButton {
    background-color: #ffffff;
    color: #34445c;
    border: 1px solid #d8e0eb;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f0f5fc;
    border-color: #a9bfdc;
}

QPushButton:pressed {
    background-color: #e4edf9;
}

#loadButton,
#updateButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
}

#loadButton:hover,
#updateButton:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafd;
    color: #26364d;
    border: 1px solid #dce4ef;
    border-radius: 10px;
    gridline-color: #e8edf4;
    selection-background-color: #e5efff;
    selection-color: #173b74;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #f1f5fa;
    color: #52627a;
    border: none;
    border-bottom: 1px solid #dce4ef;
    padding: 11px 12px;
    font-size: 12px;
    font-weight: 700;
}

QTableWidget::item {
    padding: 7px;
}

QSpinBox {
    background-color: #ffffff;
    color: #26364d;
    border: 1px solid #d8e0eb;
    border-radius: 7px;
    padding: 8px 10px;
    min-width: 90px;
    font-size: 13px;
}

QSpinBox:focus {
    border-color: #7aa7f7;
}

#aboutTitle {
    color: #17243a;
    font-size: 20px;
    font-weight: 700;
}

#aboutDescription {
    color: #52627a;
    line-height: 1.5;
}

#aboutDescription a {
    color: #2563eb;
}