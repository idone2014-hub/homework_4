QMainWindow,
QDialog {
    background-color: #f4f7fb;
}

#centralWidget {
    background-color: #f4f7fb;
}

QLabel {
    color: #233044;
    font-size: 14px;
}

#heading {
    color: #17243a;
    font-size: 27px;
    font-weight: 700;
}

#subtitle {
    color: #6b778c;
    font-size: 14px;
    margin-top: 0px;
    margin-bottom: 8px;
    padding-top: 4px;
}

QPushButton {
    background-color: #ffffff;
    color: #34445c;
    border: 1px solid #d8e0eb;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f0f5fc;
    border-color: #a9bfdc;
}

QPushButton:pressed {
    background-color: #e4edf9;
}

#loadButton,
#updateButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
}

#loadButton:hover,
#updateButton:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #26364d;
    border: 1px solid #d7e0ec;
    border-radius: 10px;
    gridline-color: #cbd6e5;
    font-size: 14px;
}

QTableWidget::viewport {
    background-color: #ffffff;
}

QHeaderView::section {
    background-color: #dce8f7;
    color: #1e3557;
    border: none;
    border-right: 1px solid #c3d2e6;
    border-bottom: 1px solid #b5c6dc;
    font-size: 15px;
    font-weight: 700;
}

QHeaderView::section:horizontal {
    padding: 10px 12px;
    text-align: center;
}

QHeaderView::section:vertical {
    background-color: #edf3fa;
    color: #26364d;
    padding: 2px 8px;
    font-size: 12px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}

QTableWidget::item {
    padding: 12px;
    background-color: #ffffff;
    color: #26364d;
}

QSpinBox {
    background-color: #ffffff;
    color: #26364d;
    border: 1px solid #d8e0eb;
    border-radius: 7px;
    padding: 8px 10px;
    min-width: 90px;
    font-size: 13px;
}

QSpinBox:focus {
    border-color: #7aa7f7;
}

#aboutTitle {
    color: #17243a;
    font-size: 20px;
    font-weight: 700;
}

#aboutDescription {
    color: #52627a;
    line-height: 1.5;
}

#aboutDescription a {
    color: #2563eb;
}

QTableCornerButton::section {
    background-color: #dce8f7;
    border: none;
    border-right: 1px solid #c3d2e6;
    border-bottom: 1px solid #b5c6dc;
}